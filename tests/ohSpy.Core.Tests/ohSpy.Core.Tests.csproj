<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Moq" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Story 1.6: FakeUpnpDevice uses Kestrel + WebApplication. Shared framework ships with .NET 10 SDK
         (no PackageVersion to maintain, no Directory.Packages.props edit). It also transitively provides
         Microsoft.Extensions.{DependencyInjection,Options,Logging} so the explicit Story 1.3 / 1.5
         PackageReferences for those are pruned (NU1510). [A16 amendment candidate] -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ohSpy.Core\ohSpy.Core.csproj" />
  </ItemGroup>

  <!-- Story 1.4: SCPD + device-description fixtures copied to output for File.OpenRead. -->
  <ItemGroup>
    <None Update="Fixtures\**\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
