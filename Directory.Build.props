<Project>
  <!-- Product version (v1.0.0). Threads into AssemblyVersion/FileVersion/InformationalVersion for every
       project, and the installer derives its version from $(Version) (see ohSpy.App.csproj BuildInstaller). -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Product>ohSpy</Product>
    <Company>Linn</Company>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>recommended</AnalysisMode>
  </PropertyGroup>

  <!-- Pattern 6 async discipline: .Result / .Wait() / .GetAwaiter().GetResult() lint -->
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
