<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Allow MSBuild to build without a RID (Debug builds don't need one); only Publish/BuildInstaller require an explicit RID. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>ohSpy.App</RootNamespace>
    <AssemblyName>ohSpy.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <!-- Story 2.9: the [LibraryImport] source generator emits an unsafe stub for
         WindowOwnershipManager.SetWindowLongPtr (SYSLIB1062), so unsafe blocks must be allowed.
         App-only — ohSpy.Core remains safe (no P/Invoke per Pattern 2). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsPackageType>None</WindowsPackageType>                     <!-- Unpackaged -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>     <!-- bundle WAS -->
    <SelfContained>true</SelfContained>                               <!-- bundle .NET -->
    <PublishSingleFile>false</PublishSingleFile>                      <!-- installer wraps -->
    <!-- Pin our Program.Main as the entry point; disable the XAML-compiler-generated Main from
         App.xaml so we don't get CS0017 "multiple entry points". -->
    <StartupObject>ohSpy.App.Program</StartupObject>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Package versions live in Directory.Packages.props (Central Package Management). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Story 1.5: DiagnosticFileSink takes ILogger<DiagnosticFileSink>; ServiceRegistration calls AddLogging()
         (extension lives in Microsoft.Extensions.Logging, NOT .DependencyInjection). Version pinned centrally. -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ohSpy.Core\ohSpy.Core.csproj" />
  </ItemGroup>

  <!-- ⭐ Story 6.3 — THE install fix. `dotnet publish` for this unpackaged WinUI app drops the WinUI
       resources that the BUILD output has: the resource index (.pri), the compiled XAML (.xbf), and the
       content Assets. Without them the published/installed app crashes at first window
       (Microsoft.UI.Xaml.dll 0xc000027b — no resources to load App.xaml / MainWindow). The build output
       is correct and runs; this copies those artefacts from $(OutDir) into $(PublishDir) so the published
       app matches the build. (This — NOT the bootstrap/self-contained config — was the real install
       blocker; see Amendment A32.) -->
  <Target Name="_CopyWinUIResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_WinUIResource Include="$(OutDir)**\*.pri;$(OutDir)**\*.xbf" />
      <_WinUIAsset Include="$(OutDir)Assets\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUIResource)"
          DestinationFiles="@(_WinUIResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUIAsset)"
          DestinationFiles="@(_WinUIAsset->'$(PublishDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied @(_WinUIResource->Count()) WinUI resource file(s) + @(_WinUIAsset->Count()) asset(s) to the publish folder." />
  </Target>

  <!--
    BuildInstaller target — depends on Publish, then invokes InnoSetup compiler.
    Documented one-liner:
      dotnet build src\ohSpy.App -t:BuildInstaller -c Release -p:RuntimeIdentifier=win-x64 -p:SelfContained=true -p:WindowsAppSDKSelfContained=true
  -->
  <Target Name="BuildInstaller"
          DependsOnTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(BuildInstaller)' == 'true'">

    <PropertyGroup>
      <!-- Inno Setup may be a per-user install (%LOCALAPPDATA%\Programs — winget/modern default) or a
           machine install in Program Files (x86) (32-bit app's default) or 64-bit Program Files. Probe all
           three (prefer per-user). Override with -p:InnoSetupCompiler=... -->
      <_IsccUser>$([System.Environment]::GetFolderPath(SpecialFolder.LocalApplicationData))\Programs\Inno Setup 6\ISCC.exe</_IsccUser>
      <_IsccX86>$([System.Environment]::GetFolderPath(SpecialFolder.ProgramFilesX86))\Inno Setup 6\ISCC.exe</_IsccX86>
      <_IsccX64>$(ProgramFiles)\Inno Setup 6\ISCC.exe</_IsccX64>
      <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == '' And Exists('$(_IsccUser)')">$(_IsccUser)</InnoSetupCompiler>
      <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == '' And Exists('$(_IsccX86)')">$(_IsccX86)</InnoSetupCompiler>
      <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == '' And Exists('$(_IsccX64)')">$(_IsccX64)</InnoSetupCompiler>
      <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == ''">$(_IsccX86)</InnoSetupCompiler>
      <InstallerOutputDir>$(MSBuildThisFileDirectory)..\..\installer\out</InstallerOutputDir>
      <InstallerVersion>$([System.DateTime]::UtcNow.ToString("yyyy.MM.dd.HHmm"))</InstallerVersion>
      <!-- Deterministic publish path: matches the default Publish target output regardless of whether
           a publish profile was used. Avoids the case where the pubxml's PublishDir and MSBuild's
           default disagree, resulting in an empty installer. -->
      <InstallerPublishDir>$(MSBuildThisFileDirectory)bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</InstallerPublishDir>
    </PropertyGroup>

    <Error Condition="!Exists('$(InnoSetupCompiler)')"
           Text="Inno Setup compiler not found at '$(InnoSetupCompiler)'. Install Inno Setup 6 from https://jrsoftware.org/isdl.php or override InnoSetupCompiler." />

    <Error Condition="!Exists('$(InstallerPublishDir)ohSpy.App.exe')"
           Text="Publish output not found at '$(InstallerPublishDir)'. The Publish target should have produced this. Confirm RuntimeIdentifier=win-x64 is set on the build command line." />

    <MakeDir Directories="$(InstallerOutputDir)" />

    <Exec Command="&quot;$(InnoSetupCompiler)&quot; /Q /DPublishDir=&quot;$(InstallerPublishDir.TrimEnd('\'))&quot; /DOutputDir=&quot;$(InstallerOutputDir)&quot; /DVersion=$(InstallerVersion) &quot;$(MSBuildThisFileDirectory)..\..\installer\ohSpy.iss&quot;" />

    <Message Text="Installer built: $(InstallerOutputDir)\ohSpy-setup-$(InstallerVersion)-x64.exe" Importance="high" />
  </Target>
</Project>
