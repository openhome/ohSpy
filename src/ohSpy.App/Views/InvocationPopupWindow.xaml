<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ohSpy.App.Views.InvocationPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ohSpy.Core.ViewModels"
    xmlns:models="using:ohSpy.Core.Models"
    xmlns:conv="using:ohSpy.App.Converters"
    Title="Invoke action"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,16,0,8" />
            </Style>
            <Style x:Key="ArgNameStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,16,0" />
            </Style>

            <!-- Story 3.3: heterogeneous input rendering — one control per argument variant
                 (FR-102 ComboBox / FR-103 NumberBox / 3.2 TextBox). Keyed on the VM runtime subtype. -->
            <conv:ArgumentInputTemplateSelector x:Key="ArgumentInputTemplateSelector">
                <conv:ArgumentInputTemplateSelector.TextTemplate>
                    <DataTemplate x:DataType="vm:ArgumentInputViewModel">
                        <Grid Margin="0,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextWrapping="Wrap" Style="{StaticResource ArgNameStyle}" />
                            <TextBox Grid.Column="1" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </DataTemplate>
                </conv:ArgumentInputTemplateSelector.TextTemplate>

                <conv:ArgumentInputTemplateSelector.ListTemplate>
                    <DataTemplate x:DataType="vm:AllowedValueListArgumentViewModel">
                        <Grid Margin="0,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextWrapping="Wrap" Style="{StaticResource ArgNameStyle}" />
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind AllowedValues}"
                                SelectedItem="{x:Bind SelectedValue, Mode=TwoWay}" />
                        </Grid>
                    </DataTemplate>
                </conv:ArgumentInputTemplateSelector.ListTemplate>

                <conv:ArgumentInputTemplateSelector.RangeTemplate>
                    <DataTemplate x:DataType="vm:AllowedValueRangeArgumentViewModel">
                        <Grid Margin="0,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextWrapping="Wrap" Style="{StaticResource ArgNameStyle}" VerticalAlignment="Top" Margin="0,8,16,0" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <NumberBox
                                    HorizontalAlignment="Stretch"
                                    Minimum="{x:Bind Minimum}"
                                    Maximum="{x:Bind Maximum}"
                                    SmallChange="{x:Bind StepOrOne}"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind NumericValue, Mode=TwoWay}" />
                                <!-- AC-3.3.6 inline off-step / out-of-range error. An empty/null
                                     ValidationError leaves the TextBlock with no text → zero height
                                     (no converter needed — a converter's StaticResource lookup root is
                                     a FrameworkElement, unavailable under a Window-rooted x:Bind). -->
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Text="{x:Bind ValidationError, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </conv:ArgumentInputTemplateSelector.RangeTemplate>
            </conv:ArgumentInputTemplateSelector>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- AC-3.2.11: device-gone banner. Visible only after DeviceRemoved (already-shown data stays). -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,8"
            Visibility="{x:Bind BannerVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.DeviceGoneText, Mode=OneWay}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Header: action title (AC-3.2.1). -->
        <TextBlock
            Grid.Row="1"
            Margin="24,16,24,0"
            FontSize="18"
            FontWeight="SemiBold"
            Text="{x:Bind ViewModel.Title}" />

        <ScrollViewer Grid.Row="2" Padding="24,8,24,24" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ── Input arguments (FR-026) ── -->
                <TextBlock Text="Input arguments" Style="{StaticResource SectionHeaderStyle}" />

                <!-- AC-3.2.5: neutral hint when the action has no inputs. -->
                <TextBlock
                    Text="No input arguments"
                    Foreground="{StaticResource MutedForegroundBrush}"
                    FontStyle="Italic"
                    Visibility="{x:Bind NoInputsVisibility}" />

                <!-- AC-3.3.1: "Loading…" hint while InitializeAsync fetches+parses the SCPD state table. -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,4"
                    Visibility="{x:Bind LoadingInputsVisibility, Mode=OneWay}">
                    <ProgressRing Width="16" Height="16" IsActive="True" />
                    <TextBlock
                        Text="Loading…"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource MutedForegroundBrush}"
                        FontStyle="Italic" />
                </StackPanel>

                <!-- Story 3.3: heterogeneous input rendering via the variant template selector. -->
                <ItemsControl
                    ItemsSource="{x:Bind ViewModel.Inputs}"
                    IsEnabled="{x:Bind IsInputEnabled, Mode=OneWay}"
                    ItemTemplateSelector="{StaticResource ArgumentInputTemplateSelector}" />

                <!-- ── Invoke + status (FR-027) ── -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0" VerticalAlignment="Center">
                    <Button Content="Invoke" Command="{x:Bind ViewModel.InvokeCommand}" />
                    <ProgressRing
                        Width="18" Height="18"
                        IsActive="{x:Bind ViewModel.IsInvoking, Mode=OneWay}"
                        Visibility="{x:Bind InvokingVisibility, Mode=OneWay}" />
                    <TextBlock
                        Text="Invoking…"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource MutedForegroundBrush}"
                        Visibility="{x:Bind InvokingVisibility, Mode=OneWay}" />
                </StackPanel>

                <!-- ── Result (FR-028/029/030) ── -->
                <TextBlock Text="Result" Style="{StaticResource SectionHeaderStyle}" />

                <!-- No result yet. -->
                <TextBlock
                    Text="No result yet — press Invoke."
                    Foreground="{StaticResource MutedForegroundBrush}"
                    FontStyle="Italic"
                    Visibility="{x:Bind NoResultVisibility, Mode=OneWay}" />

                <!-- Success (AC-3.2.7). -->
                <StackPanel Visibility="{x:Bind SuccessVisibility, Mode=OneWay}">
                    <TextBlock
                        Text="Success (no output)"
                        Foreground="{StaticResource MutedForegroundBrush}"
                        FontStyle="Italic"
                        Visibility="{x:Bind SuccessNoOutputVisibility, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind SuccessOutputs, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SoapArgument">
                                <Grid Margin="0,2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextWrapping="Wrap" Style="{StaticResource ArgNameStyle}" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- UPnP fault (AC-3.2.8) — caution styling distinguishes it from success/transport. -->
                <Border
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Visibility="{x:Bind FaultVisibility, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="UPnP fault" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind FaultText, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Transport error (AC-3.2.9) — critical styling distinguishes it from a UPnP fault. -->
                <Border
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Visibility="{x:Bind TransportVisibility, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEB90;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Transport error" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind TransportText, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
