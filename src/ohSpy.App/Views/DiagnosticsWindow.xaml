<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ohSpy.App.Views.DiagnosticsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:diag="using:ohSpy.Core.Diagnostics"
    xmlns:conv="using:ohSpy.App.Converters"
    Title="Diagnostics"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
            <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            </Style>
            <Style x:Key="CellStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- severity filter affordance -->
            <RowDefinition Height="Auto" />
            <!-- column headers -->
            <RowDefinition Height="*" />
            <!-- virtualised rows -->
        </Grid.RowDefinitions>

        <!-- AC-5.1.4: the single MinSeverity operator control (couples emitter gate + view filter).
             A ComboBox of the selectable severities; selection drives ViewModel.MinSeverity. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="16,12,16,8" VerticalAlignment="Center">
            <TextBlock Text="Minimum severity:" VerticalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" />
            <ComboBox
                x:Name="MinSeverityCombo"
                ItemsSource="{x:Bind ViewModel.SelectableSeverities}"
                SelectedItem="{x:Bind ViewModel.MinSeverity, Mode=TwoWay}"
                MinWidth="140" />
        </StackPanel>

        <!-- Column headers (fixed; match the per-row grid below). -->
        <Grid Grid.Row="1" Margin="16,0,16,4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <!-- Timestamp -->
                <ColumnDefinition Width="90" />
                <!-- Severity -->
                <ColumnDefinition Width="160" />
                <!-- Category -->
                <ColumnDefinition Width="*" MinWidth="160" />
                <!-- Message -->
                <ColumnDefinition Width="160" />
                <!-- Identity -->
                <ColumnDefinition Width="140" />
                <!-- Endpoint -->
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Time (UTC)" Style="{StaticResource ColHeaderStyle}" />
            <TextBlock Grid.Column="1" Text="Severity" Style="{StaticResource ColHeaderStyle}" />
            <TextBlock Grid.Column="2" Text="Category" Style="{StaticResource ColHeaderStyle}" />
            <TextBlock Grid.Column="3" Text="Message" Style="{StaticResource ColHeaderStyle}" />
            <TextBlock Grid.Column="4" Text="Identity" Style="{StaticResource ColHeaderStyle}" />
            <TextBlock Grid.Column="5" Text="Endpoint" Style="{StaticResource ColHeaderStyle}" />
        </Grid>

        <!-- NFR-P1: item-virtualised list (ItemsRepeater in a ScrollViewer — the SSDP-log /
             subscription-event-list precedent). Newest-first (Entries is the live ring). -->
        <ScrollViewer
            Grid.Row="2"
            x:Name="RowsScrollViewer"
            Margin="0,0,0,8"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled">
            <ItemsRepeater
                x:Name="RowsRepeater"
                ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                ElementPrepared="OnRowPrepared">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="diag:DiagnosticRow">
                        <Grid Padding="16,2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" MinWidth="160" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <!-- Timestamp (UTC HH:mm:ss.fff) — projected string, never the struct (FR-041). -->
                            <TextBlock
                                Grid.Column="0"
                                Text="{x:Bind TimestampDisplay}"
                                Style="{StaticResource CellStyle}"
                                Foreground="{StaticResource MutedForegroundBrush}" />
                            <!-- Severity — coloured via the App converter (AC-5.1.2). Classic {Binding}
                                 (NOT x:Bind): x:Bind + a {StaticResource} converter does not compile when the
                                 XAML root is a Window (WinUI 3 Window is not a FrameworkElement, so the
                                 generated resource lookup fails). And a plain {Binding} would find a null
                                 DataContext on an ItemsRepeater row. So OnRowPrepared sets each realized row's
                                 DataContext to its DiagnosticRow — then this {Binding} resolves and runs the
                                 converter. -->
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind SeverityLabel}"
                                Style="{StaticResource CellStyle}"
                                Foreground="{Binding Entry.Severity, Converter={StaticResource SeverityToBrush}}" />
                            <!-- Category -->
                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind Entry.Category}"
                                Style="{StaticResource CellStyle}" />
                            <!-- Message -->
                            <TextBlock
                                Grid.Column="3"
                                Text="{x:Bind Entry.Message}"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CellStyle}"
                                TextWrapping="Wrap" />
                            <!-- Identity (pre-resolved label; AC-5.1.7) -->
                            <TextBlock
                                Grid.Column="4"
                                Text="{x:Bind IdentityLabel}"
                                Style="{StaticResource CellStyle}" />
                            <!-- Endpoint (pre-resolved label; AC-5.1.8) -->
                            <TextBlock
                                Grid.Column="5"
                                Text="{x:Bind EndpointLabel}"
                                Style="{StaticResource CellStyle}" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Window>
