<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ohSpy.App.Views.PropertiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Device Properties"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <!-- Read-only field label (left column of each row). -->
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,2,16,2" />
            </Style>

            <!-- Read-only field value. -->
            <Style x:Key="FieldValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="Margin" Value="0,2,0,2" />
            </Style>

            <!-- Section header (FR-052 grouping). -->
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,16,0,8" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- AC-2.9.6: device-gone banner. Visible only after DeviceRemoved (snapshot data stays). -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,8"
            Visibility="{x:Bind BannerVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Center" />
                <TextBlock
                    Text="{x:Bind ViewModel.DeviceGoneText, Mode=OneWay}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24,8,24,24" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ── Identity ── -->
                <TextBlock Text="Identity" Style="{StaticResource SectionHeaderStyle}" />
                <Grid ColumnSpacing="8" RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Friendly name" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.FriendlyName}" Style="{StaticResource FieldValueStyle}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Device type" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DeviceTypeUrn}" Style="{StaticResource FieldValueStyle}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="UDN" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Udn}" Style="{StaticResource FieldValueStyle}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="UUID" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.Uuid}" Style="{StaticResource FieldValueStyle}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Presentation URL" Style="{StaticResource FieldLabelStyle}" />
                    <!-- Hyperlink when the resolved Uri is http(s); plain "—"/text otherwise. -->
                    <Grid Grid.Row="4" Grid.Column="1">
                        <HyperlinkButton
                            Padding="0" Margin="0,2"
                            Content="{x:Bind ViewModel.PresentationUrl}"
                            Command="{x:Bind ViewModel.OpenUrlCommand}"
                            CommandParameter="{x:Bind ViewModel.PresentationUri}"
                            Visibility="{x:Bind PresentationLinkVisibility}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.PresentationUrl}"
                            Style="{StaticResource FieldValueStyle}"
                            Visibility="{x:Bind PresentationTextVisibility}" />
                    </Grid>
                </Grid>

                <!-- ── Manufacturer ── -->
                <TextBlock Text="Manufacturer" Style="{StaticResource SectionHeaderStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Manufacturer" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Manufacturer}" Style="{StaticResource FieldValueStyle}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Manufacturer URL" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Grid.Row="1" Grid.Column="1">
                        <HyperlinkButton
                            Padding="0" Margin="0,2"
                            Content="{x:Bind ViewModel.ManufacturerUrl}"
                            Command="{x:Bind ViewModel.OpenUrlCommand}"
                            CommandParameter="{x:Bind ViewModel.ManufacturerUri}"
                            Visibility="{x:Bind ManufacturerLinkVisibility}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ManufacturerUrl}"
                            Style="{StaticResource FieldValueStyle}"
                            Visibility="{x:Bind ManufacturerTextVisibility}" />
                    </Grid>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Model name" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.ModelName}" Style="{StaticResource FieldValueStyle}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Model number" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.ModelNumber}" Style="{StaticResource FieldValueStyle}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Model description" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.ModelDescription}" Style="{StaticResource FieldValueStyle}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Model URL" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Grid.Row="5" Grid.Column="1">
                        <HyperlinkButton
                            Padding="0" Margin="0,2"
                            Content="{x:Bind ViewModel.ModelUrl}"
                            Command="{x:Bind ViewModel.OpenUrlCommand}"
                            CommandParameter="{x:Bind ViewModel.ModelUri}"
                            Visibility="{x:Bind ModelLinkVisibility}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ModelUrl}"
                            Style="{StaticResource FieldValueStyle}"
                            Visibility="{x:Bind ModelTextVisibility}" />
                    </Grid>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Serial number" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.SerialNumber}" Style="{StaticResource FieldValueStyle}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="UPC" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.Upc}" Style="{StaticResource FieldValueStyle}" />
                </Grid>

                <!-- ── Network ── -->
                <TextBlock Text="Network" Style="{StaticResource SectionHeaderStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Location URL" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Grid.Row="0" Grid.Column="1">
                        <HyperlinkButton
                            Padding="0" Margin="0,2"
                            Content="{x:Bind ViewModel.LocationUrl}"
                            Command="{x:Bind ViewModel.OpenUrlCommand}"
                            CommandParameter="{x:Bind ViewModel.LocationUri}"
                            Visibility="{x:Bind LocationLinkVisibility}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.LocationUrl}"
                            Style="{StaticResource FieldValueStyle}"
                            Visibility="{x:Bind LocationTextVisibility}" />
                    </Grid>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="IP" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Ip}" Style="{StaticResource FieldValueStyle}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Port" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Port}" Style="{StaticResource FieldValueStyle}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="SSDP server" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SsdpServer}" Style="{StaticResource FieldValueStyle}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="CACHE-CONTROL max-age (s)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.CacheControlMaxAgeSeconds}" Style="{StaticResource FieldValueStyle}" />
                </Grid>

                <!-- ── Discovery history ── -->
                <TextBlock Text="Discovery history" Style="{StaticResource SectionHeaderStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="First seen" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.FirstSeenUtc}" Style="{StaticResource FieldValueStyle}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Last seen" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.LastSeenUtc}" Style="{StaticResource FieldValueStyle}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Alive count" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.AliveCount}" Style="{StaticResource FieldValueStyle}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="BOOTID.UPNP.ORG" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.BootId}" Style="{StaticResource FieldValueStyle}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="CONFIGID.UPNP.ORG" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.ConfigId}" Style="{StaticResource FieldValueStyle}" />
                </Grid>

                <!-- ── Embedded devices (Decision 5: always a placeholder — model flattens per FR-053) ── -->
                <TextBlock Text="Embedded devices" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock
                    Text="&#x2014; (services flattened per FR-053)"
                    Foreground="{StaticResource MutedForegroundBrush}"
                    FontStyle="Italic"
                    Visibility="{x:Bind EmbeddedPlaceholderVisibility}" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
