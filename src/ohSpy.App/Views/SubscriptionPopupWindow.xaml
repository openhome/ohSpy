<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ohSpy.App.Views.SubscriptionPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ohSpy.Core.ViewModels"
    xmlns:models="using:ohSpy.Core.Models"
    Title="Subscribe"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="PropNameStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,0,16,0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- status / lapse banner -->
            <RowDefinition Height="Auto" />
            <!-- service header -->
            <RowDefinition Height="Auto" />
            <!-- anchored "Latest property values" summary (always visible) -->
            <RowDefinition Height="*" />
            <!-- scrolling virtualised event list -->
        </Grid.RowDefinitions>

        <!-- AC-4.3.4 / .5: status / lapse / device-gone / failed-subscribe banner. Visible for every
             non-Subscribed/Subscribing status (already-shown events/values stay). -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,8"
            Visibility="{x:Bind BannerVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind BannerText, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Header: service identifier + a small live status line (AC-4.3.10). -->
        <StackPanel Grid.Row="1" Margin="24,16,24,8" Spacing="2">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.Title}" />
            <TextBlock
                FontSize="12"
                Foreground="{StaticResource MutedForegroundBrush}"
                Text="{x:Bind StatusLine, Mode=OneWay}" />
        </StackPanel>

        <!-- AC-4.3.10: "Latest property values" summary anchored at the top, OUTSIDE the event
             ScrollViewer, so it stays visible regardless of event-list scroll. Overwrite-in-place. -->
        <Border
            Grid.Row="2"
            Margin="24,0,24,8"
            Padding="12,8"
            CornerRadius="4"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="4">
                <TextBlock Text="Latest property values" Style="{StaticResource SectionHeaderStyle}" />

                <!-- Empty hint until the first NOTIFY merges a value. -->
                <TextBlock
                    Text="No events received yet."
                    Foreground="{StaticResource MutedForegroundBrush}"
                    FontStyle="Italic"
                    Visibility="{x:Bind NoLatestVisibility, Mode=OneWay}" />

                <!-- Height-capped + scrollable so a large property set (e.g. openhome.org:Product with
                     its many vars + a huge SourceXml) stays anchored but does not overflow the window. -->
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.LatestPropertyValues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LatestPropertyValue">
                                <Grid Margin="0,2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextWrapping="Wrap" Style="{StaticResource PropNameStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Value, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- AC-4.3.10 / NFR-P1: the scrolling, item-virtualised event list (newest-first). An
             ItemsRepeater inside a ScrollViewer realises only the visible rows (the BoundedObservable
             collection caps at 5,000 — virtualisation keeps it smooth). -->
        <Grid Grid.Row="3" Margin="24,0,24,16" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Events (newest first)" Style="{StaticResource SectionHeaderStyle}" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Events}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:EventNotification">
                            <Border
                                Padding="8,6"
                                CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource MutedForegroundBrush}"
                                            Text="{x:Bind ReceivedUtc}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource MutedForegroundBrush}"
                                            Text="{x:Bind Seq}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{x:Bind PropertyRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:EventProperty">
                                                <Grid Margin="0,1" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedForegroundBrush}" VerticalAlignment="Top" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontSize="12" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
