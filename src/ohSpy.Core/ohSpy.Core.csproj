<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- Story 1.5: DiagnosticEmitter takes ILogger<DiagnosticEmitter>. Version pinned in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- Story 2.5: MVVM source-gen for ViewModels (ObservableObject, ObservableProperty, RelayCommand). Version pinned in Directory.Packages.props at 8.4.0. Core is platform-independent; CommunityToolkit.Mvvm targets net standard — no WinUI dependency, NetArchTest boundary still holds. -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <!-- Story 1.3: tests need access to UpnpHttpClient's internal test-only ctor + HttpClientTimeoutForTests accessor. -->
    <InternalsVisibleTo Include="ohSpy.Core.Tests" />
    <!-- Story 1.3 (+ 1.5): the App composition root registers internal-sealed Core types (UpnpHttpClient, DiagnosticEmitter, DiagnosticRingSink, NullIdentityLookup). -->
    <InternalsVisibleTo Include="ohSpy.App" />
    <!-- Story 6.2: the headless SOAK harness drives the REAL Core stack and needs internal
         test seams: DiagnosticFileSink's internal temp-dir ctor (rolling log → temp dir, not
         %LOCALAPPDATA%) + ShellViewModel.SetRescanDelayForTest / WaitForStartupAsync. The soak
         project is invoked by path only (NOT in ohSpy.sln) so this never affects the default build. -->
    <InternalsVisibleTo Include="ohSpy.Soak.Tests" />
  </ItemGroup>

</Project>
